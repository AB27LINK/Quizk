# QUIZK Environment Variables ("No Cap, Just Facts.")

# Application Port (local server)
PORT=3001

# Google Gemini API Key (Required for live AI quiz generation)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Secret for Session Authentication Cookies
JWT_SECRET=quizk_super_secret_jwt_key_2026_no_cap_just_facts

# Node Environment
NODE_ENV=development

# Optional: Turso / libSQL Persistent Cloud Database (Recommended for Vercel Serverless)
# Set these in your Vercel project settings to persist quizzes, users, and streaks across serverless cold starts.
# Free signup at: https://turso.tech
# TURSO_DATABASE_URL=libsql://your-database-name.turso.io
# TURSO_AUTH_TOKEN=your_turso_auth_token_here
